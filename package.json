{
  "name": "writeoffs.io",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --reporter=line",
    "ci-checks": "npm run typecheck && npm run lint && npm run build && npm run test",
    "grant:membership": "node scripts/grant-local-membership.mjs",
    "staging:test-user:reset": "node scripts/reset-staging-test-user.mjs",
    "staging:fixture:realtor": "node scripts/populate-staging-realtor.mjs",
    "staging:fixture:realtor:report": "vite-node --script scripts/report-staging-realtor.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.79.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "next": "16.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "plaid": "^46.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "stripe": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "24.7.0",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "postcss": "8.5.26",
    "postcss-selector-parser": "^6.0.13",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.4.5",
    "vitest": "3.2.6"
  }
}
