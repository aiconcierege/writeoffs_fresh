# Public Supabase configuration
WRITEOFFS_ENVIRONMENT=local
WRITEOFFS_EXPECTED_SUPABASE_HOST=
ALLOW_REMOTE_SUPABASE_IN_DEV=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated HMAC secret; the server-role key is the server-only fallback.
WAITLIST_RATE_LIMIT_SECRET=

# Authentication policy: enrolled challenges existing factors; required also requires enrollment.
MFA_ENFORCEMENT_MODE=enrolled
WRITEOFFS_STAGING_TEST_USERS=
WRITEOFFS_STAGING_MFA_BYPASS_ENABLED=false

# Plaid Sandbox only. Never commit real credentials or encryption keys.
PLAID_ENV=sandbox
PLAID_PRODUCTION_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
PLAID_SANDBOX_LINK_ENABLED=false

# Optional server-only bookkeeping AI shadow evaluation. Disabled by default.
BOOKKEEPING_AI_SHADOW_ENABLED=false
BOOKKEEPING_AI_MODEL=
RECEIPT_UNDERSTANDING_ENABLED=false
RECEIPT_UNDERSTANDING_PROVIDER=openai
RECEIPT_UNDERSTANDING_MODEL=
OPENAI_API_KEY=
GCV_API_KEY=
BOOKKEEPING_WORKER_SECRET=
CRON_SECRET=
DOCUMENT_EXPENSIVE_PROCESSING_ENABLED=true

# Stripe membership billing. Test mode only outside production.
WRITEOFFS_STRIPE_MODE=test
STRIPE_MEMBERSHIP_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPENSES_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
MEMBERSHIP_PAYMENT_GRACE_DAYS=7
MEMBERSHIP_EXPENSES_PLAID_ITEM_LIMIT=3
MEMBERSHIP_BUSINESS_PLAID_ITEM_LIMIT=8
