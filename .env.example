# Public environment policy
WRITEOFFS_ENVIRONMENT=local
NEXT_PUBLIC_ENABLE_SIGNUP=false

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only waitlist configuration. Never expose these as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Optional HMAC secret; the service-role key is the server-only fallback.
WAITLIST_RATE_LIMIT_SECRET=
