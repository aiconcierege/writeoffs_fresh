# Credentials and operator-local state never belong in deployments.
.env*
supabase/.temp/
backups/
*.wobak
*.dump
*.backup
writeoffs-backup-*/
writeoffs-restore-*/

# Rebuilt by the deployment, not uploaded from a developer workspace.
.git/
node_modules/
.next/
.vercel/
.cache/
out/
dist/
coverage/
test-results/
playwright-report/
playwright/.cache/
*.tsbuildinfo
next-env.d.ts
*.log
.DS_Store
